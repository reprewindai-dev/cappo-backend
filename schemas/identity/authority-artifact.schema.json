{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authority Artifact",
  "type": "object",
  "properties": {
    "authority_id": { "type": "string" },
    "ephemeral_execution_id": { "type": "string" },
    "scope_hash": { "type": "string" },
    "policy_decision_hash": { "type": "string" },
    "candidate_act_hash": { "type": "string" },
    "destination_hash": { "type": "string" },
    "rights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issued_at": { "type": "integer" },
    "expires_at": { "type": "integer" },
    "proof_of_possession": { "type": "string" }
  },
  "required": [
    "authority_id",
    "ephemeral_execution_id",
    "scope_hash",
    "policy_decision_hash",
    "candidate_act_hash",
    "destination_hash",
    "rights",
    "issued_at",
    "expires_at",
    "proof_of_possession"
  ],
  "additionalProperties": false
}
