# CAPPO Backend Configuration Template

# Runtime Environment (development | staging | production)
ENVIRONMENT=development

# Database Connection URL
# For local development (SQLite):
DATABASE_URL=sqlite+pysqlite:///./cappo.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cappodb

# Production Governance Rule
# When set to true, a missing database session is fatal for PGL (no transient fallbacks allowed).
# Must be set to true in production.
CAPPO_REQUIRE_PERSISTENT_PGL=false

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION IDENTITY SIGNING (Enterprise-Grade)
# ─────────────────────────────────────────────────────────────────────────────
# Provider: hmac | aws | azure | vault
#   - hmac: HMAC-SHA256 (dev/staging only, NOT for production)
#   - aws: AWS KMS HSM-backed ECDSA
#   - azure: Azure Key Vault HSM-backed ECDSA
#   - vault: HashiCorp Vault Transit engine
#
# For production: Use HSM-backed signing (aws/azure/vault) for non-repudiation
# and audit compliance. Private keys never leave the HSM.
# ─────────────────────────────────────────────────────────────────────────────

EI_SIGNING_PROVIDER=hmac

# Option A: HMAC (development only - insecure, keys exposed in env)
EI_SIGNING_KEY=dev-insecure-ei-signing-key

# Option B: AWS KMS (production - recommended)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/12345678-1234-1234-1234-123456789012
# AWS_REGION=us-east-1

# Option C: Azure Key Vault (production)
# AZURE_KEY_VAULT_URL=https://myvault.vault.azure.net/keys/mykey
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# Option D: HashiCorp Vault (production)
# VAULT_URL=https://vault.example.com:8200
# VAULT_TRANSIT_KEY_NAME=cappo-ei-signing-key
# VAULT_TOKEN=s.xxxxxx

# Maximum Delegation Chain Depth for Agents
MAX_DELEGATION_DEPTH=4

# ─────────────────────────────────────────────────────────────────────────────
# VEKLOM BYOS BACKEND (Real PGL Source of Truth)
# ─────────────────────────────────────────────────────────────────────────────
# Production PGL API endpoint - the real agent registry
VEKLOM_BYOS_BACKEND_URL=https://api.veklom.com/v1
VEKLOM_API_KEY=your-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# VEKLOM PAYMENT CONFIGURATION (x402 Protocol)
# ─────────────────────────────────────────────────────────────────────────────
# Your wallet addresses for receiving payments via x402
VEKLOM_EVM_ADDRESS=0x3a74772e925b54F7dAD7FD95c9Ba30825033f970
VEKLOM_SVM_ADDRESS=YourSolanaAddressHere

# ─────────────────────────────────────────────────────────────────────────────
# X402 PAYMENT PROTOCOL
# ─────────────────────────────────────────────────────────────────────────────
# Enable x402 payment middleware (HTTP 402 Payment Required)
X402_ENABLED=true
X402_FACILITATOR_URL=https://x402.org/facilitator

# Pricing for agent services (USD)
X402_EXEC_PRICE=$0.001
X402_MINT_PRICE=$0.005

# Supported networks (comma-separated)
# Options: base, base-sepolia, zksync, zksync-sepolia, unichain, unichain-sepolia, monad
X402_NETWORKS=base,base-sepolia,zksync,unichain,monad

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Warm Cache Tier)
# ─────────────────────────────────────────────────────────────────────────────
# Redis connection for warm cache (matches docker-compose redis service)
REDIS_URL=redis://:Veklom2026Redis!@redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# CACHE CONFIGURATION (Hot/Warm/Semantic Tiers)
# ─────────────────────────────────────────────────────────────────────────────
# Enable tiered caching (hot in-process + warm Redis)
CACHE_ENABLED=true
# Warm backend: memory | redis | upstash
CACHE_WARM_BACKEND=redis
# Semantic cache for near-duplicate prompts (optional)
CACHE_SEMANTIC_ENABLED=false
CACHE_SEMANTIC_THRESHOLD=0.92

# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Provider mode: openai (covers OpenAI, Groq, Ollama via OpenAI-compatible API)
EXECUTOR_MODE=openai

# Option A: Local Ollama (part of permanent build, no API key needed)
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=not-needed-for-ollama

# Option B: OpenAI (uncomment and set key to use as primary/fallback)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# LICENSE SERVER (cappo-backend acts as the license authority)
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret for /v1/license admin endpoints.
# Set the SAME value in veklom-byos-backend as LICENSE_ADMIN_KEY.
# Leave empty to disable auth (dev only).
LICENSE_ADMIN_KEY=change-me-to-a-strong-random-secret
