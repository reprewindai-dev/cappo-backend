# CAPPO Runtime — example environment configuration.
#
# Copy to `.env` for local development and override per deployment. Values shown
# here are DEVELOPMENT defaults. In production the app fails closed at startup
# (see cappo_backend/config.py:validate_production) if any governance-critical
# setting is left at an insecure default.

# Deployment environment. "production"/"prod" enables fail-closed startup checks.
ENVIRONMENT=development

# Database connection string.
#   dev:  sqlite+pysqlite:///./cappo.db
#   prod: postgresql+psycopg://USER:PASSWORD@HOST:5432/cappo   (SQLite is rejected in prod)
DATABASE_URL=sqlite+pysqlite:///./cappo.db

# LAW 0 governance discipline.
# Must be true in production: forbids simulated / non-persisted PGL certificates.
CAPPO_REQUIRE_PERSISTENT_PGL=false

# Ed25519 signing seed for ExecutionIdentityV1.
# MUST be overridden in production with a unique hexadecimal value of at least
# 48 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
EI_SIGNING_KEY=dev-insecure-ei-signing-key

# Stable 32-byte Ed25519 private seed (64 hex characters) for signed COSE
# CapabilityActionReceipt evidence. REQUIRED in production; never commit it.
EVIDENCE_ROOT_PRIVATE_KEY_HEX=

# Maximum delegation depth permitted by the MCP gateway (rule 7).
MAX_DELEGATION_DEPTH=4

# Identity of this independently deployed runtime control service. Production
# startup fails closed without both values. Use the runtime's canonical name;
# do not substitute an invented third-runtime label.
RUNTIME_KIND=amphoteric
RUNTIME_INSTANCE=cappo-runtime-1

# --- Observability / CORS ---
# Comma-separated allowed CORS origins. "*" suits a headless API in dev;
# pin explicit origins in production, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=*

# Root log level (DEBUG/INFO/WARNING/ERROR). Logs are emitted as JSON.
LOG_LEVEL=INFO

# --- Authentication (separate layer; NOT a substitute for EI authority) ---
# When true, every non-public route requires a valid X-API-Key header.
# Must be true in production.
AUTH_ENABLED=false
# Comma-separated accepted API keys (required when AUTH_ENABLED=true).
API_KEYS=

# --- Execution layer (LLM/tool provider + circuit breaker) ---
# "echo" uses the deterministic stub (tests/local dev). Any non-echo mode enables
# provider execution. OpenAI/Groq use /chat/completions; provider name "ollama"
# selects CAPPO's native Ollama /api/chat adapter.
EXECUTOR_MODE=echo

# Primary provider.
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama: OLLAMA_BASE_URL=http://localhost:11434  (no key needed)
LLM_PROVIDER_NAME=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional Ollama root URL. When LLM_PROVIDER_NAME=ollama and LLM_BASE_URL is a
# loopback Ollama default, this value is preferred. CAPPO sends POST /api/chat
# with keep_alive=0 and stream=false.
OLLAMA_BASE_URL=

# Optional fallback provider (failover target). Enabled only when its base_url
# is set; the circuit breaker routes here when the primary trips open. A fallback
# provider named "ollama" also uses the native /api/chat adapter.
LLM_FALLBACK_PROVIDER_NAME=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Per-request timeout (seconds) and circuit-breaker tuning (applied per provider).
LLM_TIMEOUT_SECONDS=30
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_TIMEOUT=30
BREAKER_SUCCESS_THRESHOLD=1

# --- Completion cache (latency) ---
# Tiered hot (in-process) + warm (shared) cache in front of the providers.
# A cache hit short-circuits ONLY the provider call; the governed pipeline
# (PGL/EI/LAW 0) still runs on every request. Keys are scoped per workspace+tenant.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=cappo
HOT_CACHE_MAX_SIZE=1024
# Warm tier: "memory" (process-local; dev/test), "redis" (TCP/TLS, self-hosted
# or managed), or "upstash" (REST).
CACHE_WARM_BACKEND=memory
# Required when CACHE_WARM_BACKEND=redis. redis:// or rediss:// (TLS).
# Works with a self-hosted Redis and managed Redis (e.g. Upstash rediss://).
REDIS_URL=
# Required when CACHE_WARM_BACKEND=upstash (Upstash Redis REST credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Legacy Adapters ---
# Modbus Configuration
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
# SNMP Configuration
SNMP_PORT=162
SNMP_COMMUNITY=public
# Webhook Configuration
WEBHOOK_SECRET=your_super_secret_webhook_key_here

# --- MCP & PGL Gateway ---
PGL_ENDPOINT=https://api.pgl.veklom.com/v1
MCP_SERVER_URL=http://veklom-api:8088
MCP_API_KEY=your_mcp_api_key_here

# --- Veklom BYOS Backend Integration ---
# URL of the veklom-byos-backend-2 instance (used for PGL adapter)
VEKLOM_BYOS_BACKEND_URL=http://localhost:8088
# API key for authenticating with the veklom backend
VEKLOM_BYOS_API_KEY=

# --- x402 Payment Gateway (Base / USDC) ---
# Deployment-specific treasury address. Keep concrete wallet values out of source.
VEKLOM_EVM_ADDRESS=

# Deployment-specific facilitator URL; no online/success state is implied here.
X402_FACILITATOR_URL=

# Deployment-owned pricing. Keep examples unset until a canonical commercial
# contract is approved and independently reflected in the deployed environment.
X402_EXEC_PRICE=
X402_MINT_PRICE=

# Comma-separated accepted EVM networks. Configure only the networks actually
# enabled by the deployed payment policy.
X402_NETWORKS=

# --- Governed browser execution verification ---
# The frontend exchanges its user session for a BYOS-issued EdDSA CAPPO JWT.
# Configure the matching BYOS public key, issuer, and audience here.
JWT_AUTH_ENABLED=true
JWT_PUBLIC_VERIFICATION_KEY=
JWT_ALGORITHM=EdDSA
JWT_ISSUER=
JWT_AUDIENCE=

# Public Ed25519 verification material corresponding to cAPI's
# COVENANT_HTTP_SIGNING_PRIVATE_KEY.
CAPI_GATEKEEPER_PUBLIC_KEY=

# Required production human-approval and encrypted-provider secret roots.
APPROVAL_TOKEN_SIGNING_KEY=
VAULT_MASTER_KEY=
