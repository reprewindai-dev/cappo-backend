{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Mount",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "package_ref", "role", "scope", "token", "ttl_seconds", "grants", "policy", "lifecycle"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "package_ref": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "project"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "items": {"type": "string"}}
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ttl_seconds"],
      "properties": {
        "type": {"const": "ephemeral_scoped"},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "blocked", "external_send", "suppression_required"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "items": {"type": "string"}},
        "external_send": {"type": "array", "items": {"type": "string"}},
        "suppression_required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "default", "require_human_approval_for_external_send", "require_suppression_check", "persistent_memory_allowed"],
      "properties": {
        "mode": {"type": "string"},
        "default": {"const": "deny"},
        "require_human_approval_for_external_send": {"type": "boolean"},
        "require_suppression_check": {"type": "boolean"},
        "persistent_memory_allowed": {"type": "boolean"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "unmount_on"],
      "properties": {
        "state": {"enum": ["mounted", "terminated"]},
        "unmount_on": {"type": "array", "items": {"enum": ["task_complete", "token_expiry", "explicit_terminate"]}}
      }
    }
  }
}
