{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral Scoped Token Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["token_id", "mount_id", "execution_id", "package_ref", "scope", "grants", "policy", "issued_at", "expires_at", "ttl_seconds", "single_use", "nonce"],
  "properties": {
    "token_id": {"type": "string", "minLength": 1},
    "mount_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "package_ref": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "project"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1}
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "blocked", "external_send", "suppression_required"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "items": {"type": "string"}},
        "external_send": {"type": "array", "items": {"type": "string"}},
        "suppression_required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "default", "require_human_approval_for_external_send", "require_suppression_check", "persistent_memory_allowed"],
      "properties": {
        "mode": {"type": "string"},
        "default": {"const": "deny"},
        "require_human_approval_for_external_send": {"type": "boolean"},
        "require_suppression_check": {"type": "boolean"},
        "persistent_memory_allowed": {"type": "boolean"}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "single_use": {"const": true},
    "nonce": {"type": "string", "minLength": 1}
  }
}
