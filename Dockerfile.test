FROM ghcr.io/astral-sh/uv:0.3.0 AS uv
FROM python:3.11-slim

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first
COPY pyproject.toml .
COPY README.md .
COPY cappo_backend/ /app/cappo_backend/
COPY uv.lock .

RUN uv pip install --system . psycopg2-binary pytest pytest-asyncio httpx spiffe

# Copy the rest
COPY . /app/

RUN chmod +x scripts/spire/run_g0b1_test.sh
CMD ["bash", "scripts/spire/run_g0b1_test.sh"]
